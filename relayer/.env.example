# Copy to .env and load with: node --env-file=.env --import tsx src/server.ts
HOST=127.0.0.1
PORT=8787
CLUSTER=devnet
# RPC_URL=https://api.devnet.solana.com
# Signs settlements only. Keep it separate from any treasury key.
RELAYER_KEYPAIR=../keys/relayer.json
DB_PATH=relayer.db

# Upstream OpenAI-compatible provider. Leave unset to use the mock provider.
# UPSTREAM_BASE_URL=https://api.deepseek.com/v1
# UPSTREAM_API_KEY=
# UPSTREAM_MODELS=deepseek-v3=deepseek-chat

# Settlement policy
SETTLE_THRESHOLD_BPS=8000
SETTLE_BEFORE_EXPIRY_SECS=600
# 0 disables interval settling; settling closes the session.
SETTLE_INTERVAL_SECS=0
WORKER_TICK_SECS=15
RATE_LIMIT_PER_MINUTE=60
