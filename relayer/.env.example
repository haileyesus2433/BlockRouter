# Copy to .env and load with: node --env-file=.env --import tsx src/server.ts
HOST=127.0.0.1
PORT=8787
CLUSTER=devnet
# RPC_URL=https://api.devnet.solana.com
# Signs settlements only. Keep it separate from any treasury key.
RELAYER_KEYPAIR=../keys/relayer.json
DB_PATH=relayer.db

# Upstreams. Leave everything unset to use the mock provider.
# Several providers: point PROVIDERS_FILE at a copy of providers.example.json and set the key
# variables it names.
# PROVIDERS_FILE=providers.json
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# One provider for every model:
# UPSTREAM_BASE_URL=https://api.deepseek.com/v1
# UPSTREAM_API_KEY=
# UPSTREAM_MODELS=deepseek-v3=deepseek-chat

# Settlement policy
SETTLE_THRESHOLD_BPS=8000
SETTLE_BEFORE_EXPIRY_SECS=600
# 0 disables interval settling; settling closes the session.
SETTLE_INTERVAL_SECS=0
WORKER_TICK_SECS=15
RATE_LIMIT_PER_MINUTE=60
# Browser origins allowed to call the API (the dashboard in web/)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
